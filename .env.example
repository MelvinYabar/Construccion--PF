# ─── Base de datos relacional (PostgreSQL en Supabase) ───
DATABASE_URL=postgresql://user:password@host:5432/database

# ─── JWT local (HS256) para sesiones de la API ───
JWT_SECRET=parmenia-dev-secret-change-in-production

# ─── OAuth 2.0 Authorization Code flow con Google (proveedor de terceros) ───
# Documentación: https://developers.google.com/identity/openid-connect/openid-connect
# Estos valores se obtienen en Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=paste-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-google-client-secret

# URI de callback: debe coincidir EXACTAMENTE con la configurada en Google Cloud Console
# Local:    http://localhost:8000/auth/oauth/google/callback
# Render:   https://parmenia-api-r0oi.onrender.com/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# URLs estándar del proveedor Google (no cambiar a menos que cambies de proveedor)
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# Scopes solicitados al proveedor (OIDC estándar)
SCOPE=openid email profile

# URL del frontend (a donde se redirige tras el callback con el JWT)
FRONTEND_URL=http://localhost:5173

# Cookies seguras — poner "true" en producción (HTTPS)
COOKIE_SECURE=false

# ─── Supabase Auth Admin API (sincroniza usuarios creados vía OAuth) ───
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key
