    {
      "name": "Auth — OAuth Authorization Code (Google)",
      "item": [
        {
          "name": "1. Login URL (abrir en browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/oauth/google/login", "host": ["{{base_url}}"], "path": ["auth", "oauth", "google", "login"] }
          },
          "response": []
        },
        {
          "name": "2. Callback (lo llama Google, no usar directo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/oauth/google/callback?code=PASTE_CODE_HERE&state=PASTE_STATE_HERE",
              "host": ["{{base_url}}"],
              "path": ["auth", "oauth", "google", "callback"],
              "query": [
                { "key": "code", "value": "PASTE_CODE_HERE" },
                { "key": "state", "value": "PASTE_STATE_HERE" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify ID token (demo validación JWKS)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"<google_id_token_jwt>\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/oauth/google/verify", "host": ["{{base_url}}"], "path": ["auth", "oauth", "google", "verify"] }
          },
          "response": []
        }
      ]
